{
  "name": "nizima-live-speech-plugin",
  "version": "0.1.0",
  "description": "Make Live2D models in nizima LIVE speak with voice, lip sync, expressions, and subtitles via the Plugin API",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "status": "tsx src/cli/status.ts",
    "talk": "tsx src/cli/talk/talk.ts",
    "cast": "tsx src/cli/cast.ts",
    "fix-readings": "tsx src/cli/fix-readings.ts",
    "credit": "tsx src/cli/credit.ts",
    "calm-down": "tsx src/cli/calm-down.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233"
  }
}
